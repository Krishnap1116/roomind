# Copy to .env and fill in. Never commit real keys.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
SPARK_MODEL=muse-spark-1.3
# Free tier at tavily.com → Search API (1k/mo, no card). Weather needs no key.
SEARCH_API_KEY=
SEARCH_BASE=https://api.tavily.com
# How hard the model thinks on answers: minimal/low/medium/high.
ASK_EFFORT=low
# Judge depth for dissent cards and proposals. Medium replies faster.
JUDGE_EFFORT=medium
# Judge rhythm: run 5s after quiet, 20s at latest under floods.
JUDGE_IDLE_S=5
JUDGE_MAXWAIT_S=20
ROOM_NAME=Roomind demo room
MAX_ROOM_COST_USD=5.00
# Dollars per million tokens, from Meta's pricing page. The meter shows $0 until set.
PRICE_IN_PER_M=
PRICE_OUT_PER_M=
ROOMIND_PAUSED=0
DATABASE_URL=roomind.db
BASE_URL=http://localhost:8000
